{
  "name": "Billu",
  "short_name": "Billu",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#1F2937",
  "theme_color": "#111827",
  "icons": [
    {
      "src": "https://cdn-icons-png.flaticon.com/512/3022/3022251.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share-receive",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", ".pdf", "image/*"]
        }
      ]
    }
  }
}
